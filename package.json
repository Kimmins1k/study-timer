{
  "name": "study-ring-timer",
  "version": "0.1.0",
  "description": "작업 표시줄 링으로 하루 공부 시간을 보여주는 타이머",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.kimmins1k.studyringtimer",
    "productName": "공부 링 타이머",
    "executableName": "StudyRingTimer",
    "files": ["src/**/*", "!src/*.test.js"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "StudyRingTimer-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
